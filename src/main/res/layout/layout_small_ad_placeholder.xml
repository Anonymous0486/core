<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@color/white"
    android:paddingVertical="4dp"
    android:paddingHorizontal="16dp">

    <ImageView
        android:id="@+id/placeHoldersIcon"
        android:layout_width="48dp"
        android:layout_height="48dp"
        android:background="#99D9D9D9"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintBottom_toBottomOf="parent"/>

    <TextView
        android:id="@+id/placeHoldersPreloadTextView"
        android:layout_width="32dp"
        android:layout_height="wrap_content"
        android:paddingHorizontal="8dp"
        android:background="#99D9D9D9"
        android:textSize="12sp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="@+id/placeHoldersTitle" />

    <TextView
        android:id="@+id/placeHoldersTitle"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginHorizontal="8dp"
        android:ellipsize="end"
        android:maxLines="1"
        android:textAppearance="@style/TextAppearance.AppCompat.Title"
        android:background="#99D9D9D9"
        app:layout_constraintStart_toEndOf="@+id/placeHoldersIcon"
        app:layout_constraintEnd_toStartOf="@+id/placeHoldersPreloadTextView" />

    <TextView
        android:id="@+id/placeHoldersBody"
        android:ellipsize="end"
        android:maxLines="1"
        android:background="#99D9D9D9"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginHorizontal="8dp"
        android:layout_marginTop="8dp"
        android:textAppearance="@style/TextAppearance.AppCompat.Body1"
        app:layout_constraintEnd_toStartOf="@+id/placeHoldersCtaButton"
        app:layout_constraintHorizontal_bias="0.0"
        app:layout_constraintStart_toEndOf="@+id/placeHoldersIcon"
        app:layout_constraintBottom_toBottomOf="@+id/placeHoldersCtaButton" />

    <TextView
        android:id="@+id/placeHoldersCtaButton"
        android:layout_width="95dp"
        android:layout_height="32dp"
        android:layout_marginTop="8dp"
        android:background="#99D9D9D9"
        app:layout_constraintRight_toRightOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/placeHoldersTitle"
        app:layout_constraintBottom_toBottomOf="parent"/>
</androidx.constraintlayout.widget.ConstraintLayout>