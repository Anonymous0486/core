<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="AdAttribution">
        <item name="android:textSize">11.0sp</item>
        <item name="android:textColor">#ffffff</item>
        <item name="android:gravity">center</item>
        <item name="android:layout_gravity">left</item>
        <item name="android:background">@drawable/ads_icon</item>
        <item name="android:paddingLeft">3.0dip</item>
        <item name="android:paddingRight">6.0dip</item>
        <item name="android:paddingBottom">1.0dip</item>
        <item name="android:layout_width">wrap_content</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:minWidth">14dp</item>
        <item name="android:minHeight">14dp</item>
        <item name="android:text">Ad</item>
    </style>

    <style name="AppTheme.Ads" parent="Theme.AppCompat.Light">
        <item name="android:textSize">11.0sp</item>
        <item name="android:textColor">#ffffff</item>
        <item name="android:gravity">center</item>
        <item name="android:layout_gravity">left</item>
        <item name="android:background">@drawable/ads_icon</item>
        <item name="android:paddingLeft">3.0dip</item>
        <item name="android:paddingRight">6.0dip</item>
        <item name="android:paddingBottom">1.0dip</item>
        <item name="android:layout_width">wrap_content</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:minWidth">15.0px</item>
        <item name="android:minHeight">15.0px</item>
        <item name="android:text">Ad</item>
    </style>

    <style name="DefaultButtonAds">
        <item name="android:background">@drawable/bg_cta_button</item>
        <item name="cornerRadius">@dimen/ads_btn_radius</item>
        <item name="android:textColor">@color/ads_btn_text_color</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:paddingLeft">@dimen/ads_btn_padding_left</item>
        <item name="android:paddingRight">@dimen/ads_btn_padding_right</item>
        <item name="android:paddingTop">@dimen/ads_btn_padding_top</item>
        <item name="android:paddingBottom">@dimen/ads_btn_padding_bottom</item>

        <item name="rippleColor">@color/ads_btn_ripple_color</item>
        <item name="android:stateListAnimator">@null</item>
    </style>

    <style name="styleContentFont">
        <item name="android:textSize">16sp</item>
        <item name="fontFamily">@font/roboto_regular</item>
        <item name="android:focusable">true</item>
        <item name="android:clickable">true</item>
        <item name="android:foreground">?android:attr/selectableItemBackground</item>
    </style>

    //Common

    <style name="TextBoldFont">
        <item name="android:textSize">@dimen/text_size16</item>
        <item name="android:textStyle">bold</item>
        <item name="fontFamily">@font/roboto_bold</item>
    </style>

    <style name="TextMediumFont">
        <item name="android:textSize">@dimen/text_size14</item>
        <item name="fontFamily">@font/roboto_medium</item>
    </style>

    <style name="TextRegularFont">
        <item name="android:textSize">@dimen/text_size14</item>
        <item name="fontFamily">@font/roboto_regular</item>
    </style>

    <style name="CustomDialogAnimation" parent="Theme.MaterialComponents.DayNight.Dialog">
        <item name="android:windowNoTitle">true</item>
        <item name="colorPrimaryDark">@color/colorPrimaryDark</item>
        <item name="colorPrimary">@color/colorPrimary</item>

        <item name="android:windowActivityTransitions">true</item>
    </style>
    <style name="TutorialTitleFont">
        <item name="android:textSize">@dimen/tutorial_title</item>
        <item name="fontFamily">@font/roboto_bold</item>
    </style>

    <style name="TutorialContentFont">
        <item name="android:textSize">@dimen/tutorial_content</item>
        <item name="fontFamily">@font/roboto_regular</item>
    </style>

    <style name="ChooserDialogBoldFont">
        <item name="android:textSize">@dimen/text_size16</item>
        <item name="fontFamily">@font/roboto_bold</item>
    </style>

    <style name="ChooserDialogRegularFont">
        <item name="android:textSize">@dimen/text_size14</item>
        <item name="fontFamily">@font/roboto_regular</item>
    </style>

    <style name="ChooserDialogAnimation" parent="Theme.MaterialComponents.DayNight.Dialog.Bridge">
        <item name="android:windowNoTitle">true</item>
        <item name="colorPrimaryDark">@color/colorDarkGray</item>
        <item name="colorPrimary">@color/colorGray</item>

        <item name="android:windowActivityTransitions">true</item>
    </style>

    <style name="PrettyDialogBoldFont">
        <item name="android:textSize">@dimen/text_size16</item>
        <item name="fontFamily">@font/roboto_bold</item>
    </style>

    <style name="PrettyDialogRegularFont">
        <item name="android:textSize">@dimen/text_size14</item>
        <item name="fontFamily">@font/roboto_regular</item>
    </style>

    <style name="PrettyDialogAnimation" parent="Theme.MaterialComponents.DayNight.Dialog.Bridge">
        <item name="android:windowNoTitle">true</item>
        <item name="colorPrimaryDark">@color/colorDarkGray</item>
        <item name="colorPrimary">@color/colorGray</item>

        <item name="android:windowActivityTransitions">true</item>
    </style>

    <style name="style_button_back" parent="@style/Widget.AppCompat.ImageButton">
        <item name="android:layout_width">@dimen/dimen45</item>
        <item name="android:layout_height">match_parent</item>
        <item name="android:layout_centerVertical">true</item>
        <item name="android:clickable">true</item>
        <item name="android:background">?android:attr/selectableItemBackground</item>
    </style>


    <style name="SheetDialog" parent="Theme.Design.Light.BottomSheetDialog">
        <item name="android:colorBackground">@android:color/transparent</item>
        <item name="android:windowIsFloating">true</item>
        <item name="android:windowSoftInputMode">adjustResize</item>
        <item name="android:windowTranslucentStatus">true</item>
        <item name="windowNoTitle">true</item>
    </style>

    <style name="style_title_screeen" parent="@style/Widget.MaterialComponents.TextView">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:layout_centerInParent">true</item>
        <item name="android:layout_centerVertical">true</item>
        <item name="android:textSize">@dimen/text_size22</item>
        <item name="android:textColor">#2C2C2E</item>
        <item name="android:lineSpacingExtra">2sp</item>
        <item name="android:letterSpacing">0.02</item>
        <item name="android:ellipsize">end</item>
        <item name="android:gravity">start</item>
        <item name="android:maxLines">1</item>
        <item name="fontWeight">500</item>
        <item name="android:fontWeight">500</item>
    </style>

    <style name="AnimationContentFont">
        <item name="android:textSize">@dimen/dimen9</item>
        <item name="fontFamily">@font/roboto_regular</item>
    </style>


    <style name="BottomSheetCustomDialog" parent="Theme.Design.Light.BottomSheetDialog">
        <item name="bottomSheetStyle">@style/styleBottomSheet</item>
    </style>

    <style name="styleBottomSheet" parent="Widget.Design.BottomSheet.Modal">
        <item name="android:background">@android:color/transparent</item>
    </style>

    <style name="styleCommonActiveButton">
        <item name="android:textSize">@dimen/text_size14</item>
        <item name="fontFamily">@font/roboto_medium</item>
        <item name="android:textColor">@color/white</item>
    </style>
    <style name="styleDrawerHeaderProTitle">
        <item name="android:textSize">@dimen/text_size14</item>
        <item name="fontFamily">@font/roboto_medium</item>
        <item name="fontWeight">700</item>
        <item name="android:textColor">@color/white</item>
    </style>
    <style name="styleDrawerHeaderProDesc">
        <item name="android:textSize">@dimen/text_size_10</item>
        <item name="fontFamily">@font/roboto_medium</item>
        <item name="fontWeight">400</item>
        <item name="android:textColor">@color/white</item>
    </style>
    <style name="AppTheme.Custom.Progress" parent="@style/Theme.AppCompat">
        <item name="colorAccent">@color/colorPrimary</item>
    </style>

    <style name="styleCommonInactiveButton">
        <item name="android:textSize">@dimen/text_size14</item>
        <item name="fontFamily">@font/roboto_medium</item>
        <item name="android:textColor">#1F2937</item>
    </style>

    <style name="styleHomeText">
        <item name="android:textSize">@dimen/text_size14</item>
        <item name="fontFamily">@font/roboto_regular</item>
        <item name="android:fontWeight">400</item>
        <item name="android:textColor">#4B5563</item>
    </style>

    <style name="Theme.AppTheme" parent="Theme.Material3.DynamicColors.DayNight">
        <!-- Primary brand color. -->
        <item name="colorPrimary">@color/colorPrimary</item>
        <item name="colorPrimaryVariant">@color/colorPrimaryDark</item>
        <item name="colorOnPrimary">@color/white</item>
        <!-- Secondary brand color. -->
        <item name="colorSecondary">@color/colorAccent</item>
        <item name="colorSecondaryVariant">@color/colorAccentDark</item>
        <!-- Status bar color. -->
        <item name="android:statusBarColor" >?attr/colorPrimaryVariant</item>
        <!-- App Font -->
        <item name="fontFamily">@font/roboto_regular</item>

        <item name="android:windowContentTransitions">true</item>
        <item name="android:windowActionBarOverlay">true</item>
        <item name="android:textAllCaps">false</item>

    </style>

    <style name="TextMediumFont12">
        <item name="android:textSize">@dimen/text_size12</item>
        <item name="fontFamily">@font/roboto_medium</item>
    </style>

    <style name="TextRegularFont12">
        <item name="android:textSize">@dimen/text_size12</item>
        <item name="fontFamily">@font/roboto_regular</item>
    </style>

    <style name="ThemeOverlay.Catalog.BottomSheetDialog.Scrollable" parent="ThemeOverlay.Material3.BottomSheetDialog">
        <item name="bottomSheetStyle">@style/Widget.Catalog.BottomSheet.Modal.Scrollable</item>
        <!--    <item name="android:elevation">8dp</item>-->
        <!--    <item name="android:backgroundDimAmount">0.0</item>-->
    </style>

    <style name="Widget.Catalog.BottomSheet.Modal.Scrollable" parent="Widget.Material3.BottomSheet.Modal">
        <item name="paddingBottomSystemWindowInsets">false</item>
    </style>

    <style name="ClickAnimation">
        <item name="android:focusable">true</item>
        <item name="android:clickable">true</item>
        <item name="android:foreground">?android:attr/selectableItemBackground</item>
    </style>
    <style name="ClickAnimationCircle">
        <item name="android:background">@color/transparent</item>
        <item name="android:focusable">true</item>
        <item name="android:clickable">true</item>
        <item name="android:foreground">?android:attr/selectableItemBackgroundBorderless</item>
    </style>

</resources>